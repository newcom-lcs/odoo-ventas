<odoo>
    <data>
        <!-- Ensure Sales Users can see the delivery smart button -->
        <record id="view_order_form_inherit_delivery_access" model="ir.ui.view">
            <field name="name">sale.order.form.delivery.access</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <!-- Ensure the delivery button is visible to sales users -->
                <xpath expr="//button[@name='action_view_delivery']" position="attributes" optional="1">
                    <attribute name="groups">sales_team.group_sale_salesman,stock.group_stock_user</attribute>
                </xpath>
                
                <!-- Fixed: Use the exact method name for the purchase orders button -->
                <xpath expr="//button[@name='action_view_purchase_orders']" position="attributes" optional="1">
                    <attribute name="groups">sales_team.group_sale_salesman,purchase.group_purchase_user</attribute>
                    <!-- Ensure the original invisibility condition is preserved -->
                    <attribute name="attrs">{'invisible': [('purchase_order_count', '=', 0)]}</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo> 