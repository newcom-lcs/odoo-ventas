<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Ensure salespeople can see the chatter in purchase orders -->
        <record id="purchase_order_form_view_salesman" model="ir.ui.view">
            <field name="name">purchase.order.form.salesman</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="priority">99</field>  <!-- Higher priority to ensure it's applied after other views -->
            <field name="arch" type="xml">
                <!-- Make the form readonly except for the chatter -->
                <form position="attributes">
                    <attribute name="edit">false</attribute>
                    <attribute name="groups">sales_team.group_sale_salesman</attribute>
                </form>
                
                <!-- Make sure the chatter is accessible -->
                <div class="oe_chatter" position="replace">
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </div>
            </field>
        </record>
    </data>
</odoo> 