<odoo>
    <data>
        <!-- Read-only View for Stock Picking Form -->
        <record id="stock_picking_form_readonly_sales" model="ir.ui.view">
            <field name="name">stock.picking.form.readonly.sales</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <form position="attributes">
                    <attribute name="edit">false</attribute>
                    <attribute name="create">false</attribute>
                    <attribute name="delete">false</attribute>
                </form>
                <!-- Hide all buttons in the header -->
                <header position="attributes">
                    <attribute name="invisible">1</attribute>
                </header>
            </field>
            <field name="priority">99</field>
        </record>

        <!-- Read-only View for Stock Move Form -->
        <record id="stock_move_form_readonly_sales" model="ir.ui.view">
            <field name="name">stock.move.form.readonly.sales</field>
            <field name="model">stock.move</field>
            <field name="inherit_id" ref="stock.view_move_form"/>
            <field name="arch" type="xml">
                <form position="attributes">
                    <attribute name="edit">false</attribute>
                    <attribute name="create">false</attribute>
                    <attribute name="delete">false</attribute>
                </form>
                <!-- No header modification since it doesn't exist -->
            </field>
            <field name="priority">99</field>
        </record>

        <!-- Read-only View for Purchase Order Form -->
        <record id="purchase_order_form_readonly_sales" model="ir.ui.view">
            <field name="name">purchase.order.form.readonly.sales</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <form position="attributes">
                    <attribute name="edit">false</attribute>
                    <attribute name="create">false</attribute>
                    <attribute name="delete">false</attribute>
                </form>
                <!-- Hide all buttons in the header -->
                <header position="attributes">
                    <attribute name="invisible">1</attribute>
                </header>
            </field>
            <field name="priority">99</field>
        </record>
    </data>
</odoo> 