<odoo>
    <data>
        <record id="view_order_form_inherit" model="ir.ui.view">
            <field name="name">sale.order.form.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='state']" position="attributes">
                    <attribute name="selection">
                        [('draft', 'Quotation'),
                         ('manager_approval', 'Aprobación del Gerente'),
                         ('cost_approval', 'Aprobación de Costos'),
                         ('sent', 'Quotation Sent'),
                         ('sale', 'Sale Order'),
                         ('done', 'Locked'),
                         ('cancel', 'Cancelled')]
                    </attribute>
                </xpath>
                <xpath expr="//header" position="inside">
                    <button name="approve_manager" type="object" string="Aprobar Gerente"
                        attrs="{'invisible': [('state', '!=', 'manager_approval')]}"/>
                    <button name="approve_costs" type="object" string="Aprobar Costos"
                        attrs="{'invisible': [('state', '!=', 'cost_approval')]}"/>
                </xpath>
            </field>
        </record>

        <!-- Predefined Filter: Pending Manager Approval -->
        <record id="filter_pending_manager_approval" model="ir.filters">
            <field name="name">Aprobación Pendiente (Gerente)</field>
            <field name="model_id">sale.order</field>
            <field name="domain">[["state", "in", ["manager_approval"]]]</field>
            <field name="context">{}</field>
            <field name="is_default">False</field>
        </record>

        <!-- Predefined Filter: Pending Cost Approval -->
        <record id="filter_pending_cost_approval" model="ir.filters">
            <field name="name">Aprobación Pendiente (Costos)</field>
            <field name="model_id">sale.order</field>
            <field name="domain">[["state", "=", "cost_approval"]]</field>
            <field name="context">{}</field>
            <field name="is_default">False</field>
        </record>
    </data>
</odoo>
