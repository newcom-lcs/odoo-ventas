<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Record Rules for Purchase Orders -->
    <record id="purchase_order_salesman_related_rule" model="ir.rule">
        <field name="name">Purchase Orders: Related to Salesman's Orders</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="domain_force">[('id', 'in', user.env['sale.order'].search([('team_id', 'in', user.crm_team_ids.ids)]).mapped('order_line.purchase_line_ids.order_id').ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    
    <!-- Record Rules for Purchase Order Lines -->
    <record id="purchase_order_line_salesman_related_rule" model="ir.rule">
        <field name="name">Purchase Order Lines: Related to Salesman's Orders</field>
        <field name="model_id" ref="purchase.model_purchase_order_line"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="domain_force">[('id', 'in', user.env['sale.order'].search([('team_id', 'in', user.crm_team_ids.ids)]).mapped('order_line.purchase_line_ids').ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    
    <!-- Record Rules for Stock Pickings (Deliveries) -->
    <record id="stock_picking_salesman_related_rule" model="ir.rule">
        <field name="name">Stock Pickings: Related to Salesman's Orders</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="domain_force">[('sale_id', 'in', user.env['sale.order'].search([('team_id', 'in', user.crm_team_ids.ids)]).ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    
    <!-- Record Rules for Stock Moves -->
    <record id="stock_move_salesman_related_rule" model="ir.rule">
        <field name="name">Stock Moves: Related to Salesman's Orders</field>
        <field name="model_id" ref="stock.model_stock_move"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="domain_force">[('picking_id.sale_id', 'in', user.env['sale.order'].search([('team_id', 'in', user.crm_team_ids.ids)]).ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    
    <!-- Messaging Rules to allow salespeople to post messages on any document they can see -->
    <record id="mail_message_salesman_rule" model="ir.rule">
        <field name="name">Mail Messages: Sales Team</field>
        <field name="model_id" ref="mail.model_mail_message"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo> 