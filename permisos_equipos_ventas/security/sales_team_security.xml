<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="group_sale_team_manager" model="res.groups">
        <field name="name">User: Team Documents Only</field>
        <field
            name="comment"
        >The user will have an access to the documents of the sales teams he/she belongs to.</field>
        <field name="category_id" ref="base.module_category_sales_sales" />
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]" />
    </record>

    <record id="sales_team.group_sale_salesman_all_leads" model="res.groups">
        <field name="implied_ids" eval="[(6, 0, [ref('group_sale_team_manager')])]" />
    </record>

    <!-- Record Rules -->
    <record id="sales_order_team_access_rule" model="ir.rule">
        <field name="name">Sales Orders: Team Documents</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="groups" eval="[(4, ref('group_sale_team_manager'))]"/>
        <field name="domain_force">[('team_id', 'in', user.crm_team_ids.ids)]</field>
    </record>

    <record id="crm_team_access_rule" model="ir.rule">
        <field name="name">CRM: Team Documents</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="groups" eval="[(4, ref('group_sale_team_manager'))]"/>
        <field name="domain_force">[('team_id', 'in', user.crm_team_ids.ids)]</field>
    </record>

    <record id="sales_order_line_team_access_rule" model="ir.rule">
        <field name="name">Sales Order Lines: Team Documents</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="groups" eval="[(4, ref('group_sale_team_manager'))]"/>
        <field name="domain_force">[('order_id.team_id', 'in', user.crm_team_ids.ids)]</field>
    </record>

    <record id="sale_report_team_access_rule" model="ir.rule">
        <field name="name">Sales Report: Team Documents</field>
        <field name="model_id" ref="sale.model_sale_report"/>
        <field name="groups" eval="[(4, ref('group_sale_team_manager'))]"/>
        <field name="domain_force">[('team_id', 'in', user.crm_team_ids.ids)]</field>
    </record>
</odoo>