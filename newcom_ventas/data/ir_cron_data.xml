<odoo>
    <data noupdate="1">
        <record id="ir_cron_update_creation_date_from_original" model="ir.cron">
            <field name="name">Update Creation Date from Original Creation Date</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="state">code</field>
            <field name="code">model.update_creation_date_from_original()</field>
            <field name="interval_type">days</field> <!-- Default interval type -->
            <field name="interval_number">1</field> <!-- Default interval number -->
            <field name="numbercall">-1</field> <!-- Default setting, run indefinitely if activated -->
            <field name="active">False</field> <!-- Set to False to disable automatic scheduling -->
        </record>
    </data>
</odoo>
