<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_inventory_notifications" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.inventory.notifications</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='stock']//div[@name='shipping_setting_container']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="enable_inventory_notifications"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="enable_inventory_notifications" string="Habilitar Notificaciones de Inventario"/>
                        <div class="text-muted">
                            Habilite o deshabilite las notificaciones automáticas para movimientos de inventario
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo> 