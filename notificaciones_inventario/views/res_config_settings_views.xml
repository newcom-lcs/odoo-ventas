<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_inventory_notifications" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.inventory.notifications</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Notificaciones de Inventario" string="Notificaciones de Inventario">
                    <h2>Notificaciones de Inventario</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="enable_inventory_notifications"/>
                                <div class="text-muted">
                                    Habilite o deshabilite las notificaciones automáticas para movimientos de inventario
                                </div>
                                <div class="content-group">
                                    <field name="enable_inventory_notifications" class="o_field_boolean"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo> 